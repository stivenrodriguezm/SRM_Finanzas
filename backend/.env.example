# ─── Server ──────────────────────────────────────────────────────
PORT=5005

# ─── Database ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/finanzas_personales

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=una_clave_secreta_larga_y_aleatoria

# ─── Recuperación de contraseña (envío de correo) ──────────────────
# Usa una "Contraseña de aplicación" de Gmail (no tu contraseña normal):
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activa)
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=tu_correo@gmail.com
