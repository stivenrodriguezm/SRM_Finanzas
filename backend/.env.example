# ─── Server ──────────────────────────────────────────────────────
PORT=5005
# 0.0.0.0 en el Mac (LAN). En la VPS, usa 127.0.0.1 (Nginx hace de reverse proxy).
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/finanzas_personales

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=una_clave_secreta_larga_y_aleatoria

# ─── Recuperación de contraseña (envío de correo) ──────────────────
# Usa una "Contraseña de aplicación" de Gmail (no tu contraseña normal):
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activa)
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=tu_correo@gmail.com

# ─── Análisis con IA (pestaña Análisis) ────────────────────────────
# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ─── Cierre mensual (Histórico) ─────────────────────────────────────
# Zona horaria (IANA) que usa el chequeo diario para decidir "qué día es hoy" al comparar
# contra el día de cierre elegido por cada usuario. Opcional — si no se define, usa America/Bogota.
CLOSING_TIMEZONE=America/Bogota
